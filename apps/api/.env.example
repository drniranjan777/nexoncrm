# PostgreSQL connection (create the database first: CREATE DATABASE nexonweb;)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nexonweb?schema=public"
# Separate database used by integration tests (name must contain "test"; migrations are applied, data is not wiped)
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nexonweb_test?schema=public"

PORT=4000
APP_URL="http://localhost:5174"
FEEDBACK_PUBLIC_URL="http://localhost:5174"
SESSION_SECRET="change-me"
COOKIE_SECURE=false

# Background jobs (optional). Without it jobs run in-process.
REDIS_URL="redis://127.0.0.1:6379"

# Email (optional). Mail servers can also be set in the app: per organization (Settings → Email) and as the platform
# default (Platform → Settings); those take priority over these values. Without any, emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nexonweb <no-reply@nexonweb.com>"

# File storage: "local" (./storage) or "s3" (any S3-compatible endpoint)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI: "heuristic" (no network) or "anthropic"
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# PDFs (optional): override the bundled Noto Sans (apps/api/assets/fonts) with other TTF paths. Leave empty for the default.
PDF_FONT_REGULAR=
PDF_FONT_BOLD=

# Encrypts secrets stored in the database, such as SMTP passwords (falls back to SESSION_SECRET). Keep it stable:
# changing it makes saved mail passwords unreadable until they are entered again. Generate with: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
# Let organizations use mail servers on private/local addresses (off by default, to prevent probing internal hosts)
ALLOW_PRIVATE_SMTP_HOSTS=false
